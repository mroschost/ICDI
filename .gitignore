# Arquivos gerados localmente e artefatos de build/deploy.
# A branch `master` deve conter apenas o que precisa ir para a Hostinger.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build outputs
/.next/
/out/
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# caches and generated metadata
*.tsbuildinfo
.vite-*.log
.vite/
.turbo/

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem
*.zip

# local editor / IDE
.vscode/
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# platform-specific
.vercel
